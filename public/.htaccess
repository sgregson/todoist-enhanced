# Apache, which is what Infomaniak serves this from.
#
# Vite copies everything in public/ into dist/ untouched, so this ships with
# the build and there is nothing to remember at upload time.

# Apache has no media type for .webmanifest and sends the file with no
# Content-Type header at all. Chromium reads it anyway; not everything does,
# and a manifest that is not recognised is an app that cannot be installed.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# The service worker must never be served from cache, or a new build sits
# behind the old one until the browser decides otherwise; nor must the theme
# boot script, which has no hash in its name. Everything under assets/
# carries a content hash in its name and can be kept forever. The same list
# is NO_CACHE_FILES in security-headers.ts.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|theme-boot\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# What the page may load and where it may talk to.
#
# The policy and what each directive is for live in security-headers.ts at
# the root of the repository; this is Apache's copy of it, as response
# headers. The build also writes the policy into index.html as a <meta> tag,
# for hosts that cannot send headers — but only a header can carry
# frame-ancestors, which is why this copy still matters here.
#
# Change security-headers.ts first, then this line and vercel.json:
# src/securityHeaders.test.ts fails while they disagree.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.todoist.com; img-src 'self' data: blob: https:; font-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; frame-src https://tally.so; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# A single-page app behind a hash router still has exactly one document. A
# request for a path that is not a real file is that document, not a 404 —
# which is also what stops a mistyped URL returning the host's error page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
